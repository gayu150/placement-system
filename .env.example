# Recruitment & Placement Management System Environment Configuration
# Flask Settings
SECRET_KEY=recruitment-placement-secret-key-replace-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
# Supported engines: 'mysql' (default for production/MySQL labs) or 'sqlite' (for quick student testing)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=placement_db

# SQLite Database File (used if DB_ENGINE=sqlite or fallback)
SQLITE_DB_PATH=placement.db

